# Claude Code personal/local settings (machine-specific, not shared).
.claude/settings.local.json

# Obsidian editor state (machine-specific, changes constantly).
.obsidian/workspace.json

# Image/binary attachments — kept local only, not tracked in git.
attachments/

# Python bytecode cache from running .agents/scripts/*.py.
__pycache__/

# Passwords and account credentials — local only, never tracked in git.
private/

# Bank statement records — kept local only, not tracked in git.
areas/personal-finance/*Spending Account*
